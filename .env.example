# Opcional: sin keys el sistema funciona en modo determinista (plantillas).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic        # anthropic | openai | none
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=gpt-5-mini
STATE_BACKEND=memory          # memory | dynamodb
STATE_TABLE=onboarding-state
# Auth de /resolve (fail-closed). Por defecto AUTH_MODE=apigw (exige grupo Cognito "compliance").
# Local/tests sin API Gateway requiere AMBAS variables:
AUTH_MODE=none                # apigw | none
ALLOW_INSECURE_LOCAL=1        # solo local; nunca en AWS
