{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FunctionRoleRead",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole"
      ],
      "Resource": "arn:aws:iam::774305616818:role/onboarding-agent-*-function-role"
    },
    {
      "Sid": "PassRoleOnlyToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::774305616818:role/onboarding-agent-*-function-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyBoundaryRemovalOrSwap",
      "Effect": "Deny",
      "Action": "iam:DeleteRolePermissionsBoundary",
      "Resource": "*"
    },
    {
      "Sid": "DenyPutOtherBoundary",
      "Effect": "Deny",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::774305616818:policy/onboarding-agent-boundary"
        }
      }
    },
    {
      "Sid": "DenyBoundaryTampering",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion"
      ],
      "Resource": [
        "arn:aws:iam::774305616818:policy/onboarding-agent-boundary",
        "arn:aws:iam::774305616818:policy/onboarding-agent-deployer",
        "arn:aws:iam::774305616818:policy/onboarding-agent-deployer-iam"
      ]
    },
    {
      "Sid": "DenyIdentityAndRoleWrites",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateAssumeRolePolicy",
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyFunctionUrls",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyInvokePermissionExceptApiGateway",
      "Effect": "Deny",
      "Action": "lambda:AddPermission",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "lambda:Principal": "apigateway.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenySamBucketPolicyChanges",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutBucketAcl",
        "s3:PutObjectAcl",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutAccountPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyStateTableDataAndSharing",
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutResourcePolicy",
        "dynamodb:DeleteResourcePolicy",
        "dynamodb:ExportTableToPointInTime",
        "dynamodb:RestoreTableFromBackup",
        "dynamodb:RestoreTableToPointInTime",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PartiQLSelect"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyLogExfiltration",
      "Effect": "Deny",
      "Action": [
        "logs:PutSubscriptionFilter",
        "logs:CreateExportTask",
        "logs:PutDestination",
        "logs:PutDestinationPolicy"
      ],
      "Resource": "*"
    }
  ]
}
